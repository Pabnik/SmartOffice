@model SmartOffice.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Аналітична панель";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">📊 Аналітика системи</h1>
        
        <form method="get" asp-action="Dashboard" class="d-flex align-items-center">
            <label class="me-2 fw-bold text-muted text-nowrap">Фільтр за періодом:</label>
            <select name="period" class="form-select w-auto shadow-sm border-primary" onchange="this.form.submit()">
                
                @if (Model.SelectedPeriod == "all" || string.IsNullOrEmpty(Model.SelectedPeriod)) 
                { 
                    <option value="all" selected>За весь час</option> 
                } 
                else 
                { 
                    <option value="all">За весь час</option> 
                }

                @if (Model.AvailablePeriods != null)
                {
                    foreach (var p in Model.AvailablePeriods)
                    {
                        var parsedDate = DateTime.Parse(p + "-01");
                        // Змінено на uk-UA для відображення місяців українською
                        var displayMonth = parsedDate.ToString("MMMM yyyy", new System.Globalization.CultureInfo("uk-UA"));

                        if (Model.SelectedPeriod == p)
                        {
                            <option value="@p" selected>@displayMonth</option>
                        }
                        else
                        {
                            <option value="@p">@displayMonth</option>
                        }
                    }
                }
            </select>
        </form>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm h-100">
                <div class="card-body">
                    <h6>Всього бронювань</h6>
                    <h2 class="mb-0">@Model.TotalCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm h-100">
                <div class="card-body">
                    <h6>Коефіцієнт утилізації</h6>
                    <h2 class="mb-0">@Model.UtilizationRate%</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3" style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" data-bs-toggle="modal" data-bs-target="#savedHoursModal">
            <div class="card text-white bg-danger mb-3 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="card-title">Заощаджено годин <span style="font-size: 0.8em; opacity: 0.8;">(Натисніть)</span></h6>
                    <h2 class="display-6 mb-0">@Model.HoursSaved год</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white shadow-sm h-100">
                <div class="card-body">
                    <h6>Зараз активні</h6>
                    <h2 class="mb-0">@Model.ActiveCount</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">Розподіл статусів бронювань</div>
                <div class="card-body" style="position: relative; height: 300px;">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card shadow-sm p-4 h-100 border-success">
                <h5 class="text-success fw-bold"><i class="bi bi-lightning-charge-fill"></i> Економічний ефект</h5>
                <p class="text-muted small">Фінансові та операційні метрики, забезпечені системою розумного автоскасування.</p>
                <hr>
                
                <div class="row mb-3">
                    <div class="col-6">
                        <span class="text-muted d-block">Всього заброньовано</span>
                        <strong class="fs-4">@Model.TotalHoursBooked год</strong>
                    </div>
                    <div class="col-6">
                        <span class="text-muted d-block">Фактично використано</span>
                        <strong class="fs-4 text-success">@Model.ActualHoursUsed год</strong>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <span class="text-muted d-block">Відсоток неявок (No-Show)</span>
                        <strong class="fs-4 text-danger">@Model.NoShowRate%</strong>
                    </div>
                    <div class="col-6">
                        <span class="text-muted d-block">Заощаджено енергії</span>
                        <strong class="fs-4 text-warning">@Model.EnergySavedKwh кВт-год</strong>
                    </div>
                </div>

                <div class="alert alert-success mb-0 py-2">
                    <small>💡 Система зекономила <strong>@Model.EnergySavedKwh кВт-год</strong> енергії завдяки вимкненню обладнання на покинутих робочих місцях.</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">🔥 Топ 5 робочих місць</div>
                <div class="card-body" style="position: relative; height: 250px;">
                    <canvas id="topWorkspacesChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">📈 Пікові години (Навантаження)</div>
                <div class="card-body" style="position: relative; height: 250px;">
                    <canvas id="peakHoursChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">📅 Тренд утилізації за 7 днів</div>
                <div class="card-body" style="position: relative; height: 250px;">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="savedHoursModal" tabindex="-1" aria-labelledby="savedHoursModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="savedHoursModalLabel">📈 Заощаджені години (Денний тренд)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <canvas id="savedHoursChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>

    <script>
        Chart.register(ChartDataLabels);

        const trendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyTrend));
        const topData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopWorkspaces));
        const peakData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PeakHours));

        new Chart(document.getElementById('statusChart').getContext('2d'), {
        type: 'doughnut',
        data: {
        labels: ['Підтверджено', 'Скасовано користувачем', 'Авто-скасовано', 'Активно'],
        datasets: [{
        data: [@Model.CheckedInCount, @Model.CancelledByUserCount, @Model.AutoCancelledCount, @Model.ActiveCount],
        backgroundColor: ['#198754', '#ffc107', '#dc3545', '#0dcaf0'],
        hoverOffset: 4
        }]
        },
        plugins: [ChartDataLabels],
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
        legend: {
        position: 'bottom'
        },
        tooltip: {
        enabled: false
        },
        datalabels: {
        color: '#ffffff',
        font: {
        weight: 'bold',
        size: 16
        },
        formatter: function(value, context) {
        return value > 0 ? value : '';
        }
        }
        }
        }
        });

        new Chart(document.getElementById('topWorkspacesChart').getContext('2d'), {
        type: 'bar',
        data: {
        labels: topData.map(d => d.Name),
        datasets: [{
        label: 'Бронювання',
        data: topData.map(d => d.Count),
        backgroundColor: '#0d6efd',
        borderRadius: 4
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
        legend: { display: false },
        datalabels: { display: false }
        }
        }
        });

        new Chart(document.getElementById('peakHoursChart').getContext('2d'), {
        type: 'line',
        data: {
        labels: peakData.map(d => d.Hour),
        datasets: [{
        label: 'Активні бронювання',
        data: peakData.map(d => d.Count),
        borderColor: '#ffc107',
        tension: 0.3,
        fill: true,
        backgroundColor: 'rgba(255, 193, 7, 0.2)'
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
        legend: { display: false },
        datalabels: { display: false }
        }
        }
        });

        new Chart(document.getElementById('trendChart').getContext('2d'), {
        type: 'line',
        data: {
        labels: trendData.map(d => d.Date),
        datasets: [{
        label: 'Утилізація %',
        data: trendData.map(d => d.Rate),
        borderColor: '#198754',
        backgroundColor: '#198754',
        tension: 0.1,
        pointRadius: 4
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
        y: {
        min: 0,
        max: 100,
        ticks: { callback: function(value) { return value + "%" } }
        }
        },
        plugins: {
        legend: { display: false },
        datalabels: { display: false }
        }
        }
        });

        const savedHoursData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SavedHoursTrend));

        const modal = document.getElementById('savedHoursModal');
        let savedChartInstance = null;

        modal.addEventListener('shown.bs.modal', function () {
        const ctxSaved = document.getElementById('savedHoursChart').getContext('2d');

        if (savedChartInstance) {
        savedChartInstance.destroy();
        }

        savedChartInstance = new Chart(ctxSaved, {
        type: 'bar',
        data: {
        labels: savedHoursData.map(d => d.label || d.Label),
        datasets: [{
        label: 'Заощаджено годин',
        data: savedHoursData.map(d => d.hours || d.Hours),
        backgroundColor: 'rgba(220, 53, 69, 0.8)',
        borderColor: '#dc8245',
        borderWidth: 1,
        borderRadius: 4
        }]
        },
        plugins: [ChartDataLabels],
        options: {
        responsive: true,
        plugins: {
        legend: { display: false },
        tooltip: {
        callbacks: {
        label: function(context) {
        return context.parsed.y + ' годин заощаджено';
        }
        }
        },
        datalabels: {
        color: '#ffffff',
        anchor: 'end',
        align: 'bottom',
        font: {
        weight: 'bold',
        size: 16
        },
        textStrokeColor: '#000000',
        textStrokeWidth: 2,
        formatter: function(value) {
        return value > 0 ? value : '';
        }
        }
        },
        scales: {
        y: {
        beginAtZero: true,
        title: { display: true, text: 'Години' },
        grace: '10%'
        }
        }
        }
        });
        });
    </script>
}