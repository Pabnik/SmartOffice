@model IEnumerable<SmartOffice.Web.Models.WorkspaceViewModel>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h1 class="display-5">🏢 SmartOffice Admin Panel</h1>
            <p class="text-muted">Manage workspaces and system parameters.</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="/Home/Create" class="btn btn-success mt-3">+ Add New Workspace</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Room (Location)</th>
                        <th>Workspace Name</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">Room @item.Location</span></td>
                                <td><strong>@item.Name</strong></td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this workspace?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">No workspaces found. Is the API running?</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>