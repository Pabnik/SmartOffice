@model SmartOffice.Web.Models.WorkspaceViewModel

@{
    ViewData["Title"] = "Add Workspace";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">🏢 Add New Workspace</h4>
        </div>
        <div class="card-body">
            <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Room (Location)</label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. 104, 117, 404" required/>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Workspace Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Desk 5, Meeting Room D" required/>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Capacity (Number of people)</label>
                    <input asp-for="Capacity" class="form-control" type="number" min="1" max="50" required />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Amenities / Equipment</label>
                    <div class="card p-3 bg-light shadow-sm">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="HasProjector" id="checkProjector">
                            <label class="form-check-label" for="checkProjector">📽️ Projector</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="HasWhiteboard" id="checkWhiteboard">
                            <label class="form-check-label" for="checkWhiteboard">📋 Whiteboard</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="HasMonitor" id="checkMonitor">
                            <label class="form-check-label" for="checkMonitor">🖥️ Monitor</label>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Workspace</button>
                </div>
            </form>
        </div>
    </div>
</div>